{
  "name": "nextjs_stitch_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:push": "prisma db push",
    "db:clear-data": "node scripts/clear_operational_data.js",
    "audit:bank-settlements": "node scripts/review-bank-voucher-settlements.cjs",
    "audit:bank-auto-approve": "node scripts/auto-approve-pending-bank-statements.cjs",
    "check:opening-balances": "node scripts/check-opening-balance-consistency.cjs",
    "test:wallet-fallback": "node --experimental-strip-types scripts/test-wallet-revenue-fallback.mjs",
    "test:wallet-settlement": "node --experimental-strip-types scripts/test-wallet-settlement-allocation.mjs",
    "repair:wallet-settlement": "node scripts/repair-wallet-settlement-group.cjs",
    "backfill:wallet-manual": "node scripts/backfill-wallet-manual-reconciliation.cjs",
    "test:wallet-backfill": "node scripts/backfill-wallet-manual-reconciliation.cjs --self-test",
    "test:daily-deposits": "node --experimental-strip-types scripts/test-daily-deposit-report.mjs",
    "test:bank-deposits": "node --experimental-strip-types scripts/test-bank-statement-deposit.mjs",
    "test:import-dates": "node --experimental-strip-types scripts/test-import-date-parser.mjs",
    "backfill:bank-deposits": "node scripts/backfill-bank-deposits.cjs",
    "deploy:vps": "git pull origin master && npm install && npx prisma db push && npm run build && (pm2 restart ecosystem.config.js || pm2 restart all)",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "16.2.10",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
