datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/@prisma/custom-client"
  engineType = "library"
}

model Document {
  id          String   @id @default(uuid())
  code        String   @unique
  date        DateTime @default(now())
  partner     String
  description String
  amount      Float
  status      String // PENDING, COMPLETED, DRAFT

  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
}

model MasterDataItem {
  id           String   @id @default(uuid())
  type         String
  code         String
  name         String
  group        String?
  /// Mã của danh mục cha trong ba tầng phân loại thu/chi:
  /// Phân cấp P&L: PNL_ITEM lưu mã PNL_GROUP. Danh mục Thu/Chi không liên kết P&L.
  /// Riêng INVENTORY_ITEM_GROUP: lưu NHÓM KHO tương ứng của phân nhóm mặt hàng
  /// (khớp cột group của kho WAREHOUSE ở từng cửa hàng, ví dụ BEP / BAR / FOH).
  subGroup     String?
  partnerType  String?
  partnerGroup String?
  branch       String?
  taxCode      String?
  contactName  String?
  phone        String?
  email        String?
  accountNo    String?
  /// Tiền tố sinh mã tự động cho danh mục hỗ trợ cấp mã, hiện dùng cho Nhóm tài sản/CCDC.
  codePrefix   String?
  /// Nguồn tiền ngân hàng mà ví/POS này sẽ quyết toán về. Chỉ dùng cho MONEY_SOURCE nhóm WALLET,
  /// để báo cáo nguồn tiền quy được doanh thu ví chưa về bank vào cột Dự thu trong kỳ.
  settlementBankCode String?
  /// Tên "Nguồn tiền tổng" — các MONEY_SOURCE cùng tên tổng được Báo cáo nguồn tiền gộp thành một dòng.
  summarySourceName String?
  status       String   @default("ACTIVE")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deletedAt DateTime?
  deletedBy String?

  @@unique([type, code])
  @@index([type])
  @@index([status])
  @@index([partnerType])
  @@index([partnerGroup])
  @@index([subGroup])
  @@index([deletedAt])
}

model Deposit {
  id                     String           @id @default(uuid())
  code                   String           @unique
  receivedDate           DateTime         @default(now())
  partnerCode            String
  partnerName            String
  objectName             String?
  branchCode             String
  moneySourceCode        String?
  amount                 Float
  remainingAmount        Float
  purpose                String
  status                 String           @default("HOLDING")
  note                   String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  histories              DepositHistory[]
  sourceOpeningBalanceId String?          @unique
  sourceOpeningBalance   OpeningBalance?  @relation(fields: [sourceOpeningBalanceId], references: [id], onDelete: SetNull)

  deletedAt DateTime?
  deletedBy String?

  @@index([status])
  @@index([partnerCode])
  @@index([branchCode])
  @@index([deletedAt])
}

model DepositHistory {
  id            String            @id @default(uuid())
  depositId     String
  voucherId     String?
  action        String
  amount        Float?
  actionDate    DateTime?
  treatmentNote String?
  note          String?
  actor         String?
  createdAt     DateTime          @default(now())
  deposit       Deposit           @relation(fields: [depositId], references: [id], onDelete: Cascade)
  voucher       FinancialVoucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@unique([voucherId, action])
  @@index([depositId])
  @@index([voucherId])
}

model OpeningBalance {
  id                    String   @id @default(uuid())
  period                String
  branchCode            String
  balanceType           String
  objectCode            String?
  objectName            String?
  moneySourceCode       String?
  warehouseCode         String?
  departmentCode        String?
  quantity              Float?
  unitCost              Float?
  allocationMonths      Int?
  allocationStartPeriod String?
  amount                Float
  note                  String?
  status                String   @default("DRAFT")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  deletedAt DateTime?
  deletedBy String?

  deposit Deposit?

  @@index([period])
  @@index([branchCode])
  @@index([balanceType])
  @@index([status])
  @@index([deletedAt])
}

model ImportBatch {
  id           String    @id @default(uuid())
  importType   String
  templateCode String
  fileName     String
  branchCode   String?
  fileChecksum String?
  uploadedBy   String?
  status       String    @default("PREVIEW")
  totalRows    Int       @default(0)
  validRows    Int       @default(0)
  errorRows    Int       @default(0)
  mappingJson  String?
  errorJson    String?
  committedAt  DateTime?
  rolledBackAt DateTime?
  rolledBackBy String?
  rollbackNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bankTransactions      BankStatementTransaction[]
  revenueRows           RevenueImportRow[]
  payrollRows           PayrollImportRow[]
  importRows            ImportRow[]
  vouchers              FinancialVoucher[]
  moneyTransfers        MoneyTransfer[]
  debtRecords           DebtRecord[]
  inventoryTransactions InventoryTransaction[]
  assetStocktakes       AssetStocktakeSession[]

  deletedAt DateTime?
  deletedBy String?

  @@index([importType])
  @@index([status])
  @@index([createdAt])
  @@index([fileChecksum])
  @@index([deletedAt])
}

model ImportRow {
  id              String   @id @default(uuid())
  importBatchId   String
  sheetName       String
  sourceRowNumber Int
  rawJson         String
  normalizedJson  String
  errorJson       String?
  rowFingerprint  String
  targetType      String?
  targetId        String?
  createdAt       DateTime @default(now())

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, sheetName, sourceRowNumber])
  @@index([rowFingerprint])
  @@index([targetType, targetId])
}

model BankStatementTransaction {
  id                      String    @id @default(uuid())
  importBatchId           String
  transactionDate         DateTime
  bankAccount             String
  transactionCode         String
  description             String
  debitAmount             Float     @default(0)
  creditAmount            Float     @default(0)
  balanceAfter            Float?
  branchCode              String?
  partnerHint             String?
  /// Khoản mục thu/chi khai ngay trên file sao kê để giao dịch được phân loại từ lúc import.
  categoryCode            String?
  /// Các cột nghiệp vụ đã được kế toán phân loại trước trên file import.
  sourceDate              DateTime?
  revenueDate             DateTime?
  summaryMoneySourceCode  String?
  increaseMoneySourceCode String?
  decreaseMoneySourceCode String?
  operationType           String?
  accountingDate          DateTime?
  partnerCode             String?
  pnlItemCode             String?
  debtReference           String?
  depositCode             String?
  grossAmount             Float?
  grabExpenseAmount       Float     @default(0)
  cardFeeAmount           Float     @default(0)
  /// Kết quả lập chứng từ tự động hoặc lý do phải xử lý thủ công.
  autoProcessType         String?
  autoProcessNote         String?
  reconcileStatus         String    @default("UNMATCHED")
  createdAt               DateTime  @default(now())

  importBatch ImportBatch               @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  matches     ReconciliationMatch[]
  allocations BankStatementAllocation[]

  deletedAt DateTime?
  deletedBy String?

  @@unique([bankAccount, transactionCode])
  @@index([transactionDate])
  @@index([bankAccount])
  @@index([categoryCode])
  @@index([operationType])
  @@index([accountingDate])
  @@index([partnerCode])
  @@index([pnlItemCode])
  @@index([autoProcessType])
  @@index([reconcileStatus])
  @@index([deletedAt])
}

/// Một dòng phân bổ nghiệp vụ trong file khách. Nhiều dòng có thể cùng thuộc một
/// giao dịch ngân hàng (ví dụ một lần MoMo chuyển tiền cho nhiều ngày doanh thu).
model BankStatementAllocation {
  id                      String    @id @default(uuid())
  bankTransactionId       String
  sourceRowNumber         Int
  sheetName               String
  description             String
  debitAmount             Float     @default(0)
  creditAmount            Float     @default(0)
  /// Doanh thu gốc được clear ở ví cho riêng dòng phân bổ (bao gồm phí).
  grossAmount             Float?
  sourceDate              DateTime?
  revenueDate             DateTime?
  categoryCode            String?
  summaryMoneySourceCode  String?
  increaseMoneySourceCode String?
  decreaseMoneySourceCode String?
  operationType           String?
  accountingDate          DateTime?
  partnerCode             String?
  pnlItemCode             String?
  debtReference           String?
  depositCode             String?
  grabExpenseAmount       Float     @default(0)
  cardFeeAmount           Float     @default(0)
  autoProcessType         String?
  autoProcessNote         String?
  createdAt               DateTime  @default(now())

  bankTransaction BankStatementTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  @@unique([bankTransactionId, sheetName, sourceRowNumber])
  @@index([bankTransactionId])
  @@index([revenueDate])
  @@index([categoryCode])
}

model RevenueImportRow {
  id              String   @id @default(uuid())
  importBatchId   String
  saleDate        DateTime
  branchCode      String
  channel         String?
  revenueSource   String
  paymentMethod   String
  orderCount      Int?
  grossAmount     Float
  discountAmount  Float    @default(0)
  vatAmount       Float    @default(0)
  feeAmount       Float    @default(0)
  netAmount       Float
  externalRef     String
  productCode     String?
  productQuantity Float?
  inventoryStatus String?
  /// Bộ phận tạo ra doanh thu (DEPARTMENT: KIT/BAR/FOH...) — gắn lúc import để so với
  /// tỷ trọng lương từng bộ phận. Ưu tiên suy từ mã hàng -> nhóm mặt hàng -> nhóm kho;
  /// dòng không có mã hàng suy từ nguồn doanh thu (REV_FOOD -> Bếp, REV_DRINK -> Bar).
  departmentCode  String?
  createdAt       DateTime @default(now())

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  deletedBy String?

  @@unique([branchCode, saleDate, externalRef])
  @@index([saleDate])
  @@index([branchCode])
  @@index([paymentMethod])
  @@index([productCode])
  @@index([inventoryStatus])
  @@index([departmentCode])
  @@index([deletedAt])
}

model FinancialVoucher {
  id                      String   @id @default(uuid())
  importBatchId           String?
  code                    String   @unique
  sourceDocumentCode      String?
  voucherType             String
  voucherDate             DateTime @default(now())
  /// Ca làm việc của phiếu (MORNING/EVENING/FULL). Phiếu cũ để trống thì báo cáo vẫn
  /// suy ra ca theo giờ của voucherDate như trước.
  shift                   String?
  partnerCode             String?
  partnerName             String
  branchCode              String
  sourceScope             String   @default("EXTERNAL")
  /// Kênh chứng từ tại thời điểm phát sinh. Không suy luận động từ danh mục nguồn tiền
  /// vì nguồn có thể được đổi nhóm sau khi chứng từ đã ghi nhận.
  documentChannel         String   @default("CASH")
  /// RECOGNITION: ghi nhận nghiệp vụ mới; SETTLEMENT: chỉ xác nhận dòng tiền của
  /// nghiệp vụ đã ghi nhận trước đó (ví dụ sao kê khớp doanh thu POS).
  businessEffect          String   @default("RECOGNITION")
  /// Người thực nhận/chi tiền khi phiếu đại diện cho nhiều đối tác (không bắt buộc là đối tác).
  recipientName           String?
  moneySourceCode         String
  categoryCode            String?
  /// Hạng mục quản trị trên báo cáo P&L. Để trống nghĩa là chưa phân loại chi tiết,
  /// không làm thay đổi bản chất hạch toán của phiếu.
  pnlItemCode             String?
  externalRef             String?
  counterpartyAccountNo   String?
  counterpartyAccountName String?
  depositAction           String?
  depositCode             String?
  debtAction              String?
  debtReference           String?
  allocationMonths        Int?
  allocationStartPeriod   String?
  amount                  Float
  description             String
  status                  String   @default("DRAFT")
  createdBy               String?
  approvedBy              String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  importBatch      ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  depositHistories DepositHistory[]
  debtSettlements  DebtSettlement[]
  /// Phiếu chi một người nhận cho nhiều đối tác: mỗi dòng một đối tác + số tiền (+ mã công nợ).
  partnerAllocations VoucherAllocation[]

  deletedAt DateTime?
  deletedBy String?

  @@index([voucherType])
  @@index([documentChannel])
  @@index([businessEffect])
  @@index([voucherDate])
  @@index([shift])
  @@index([partnerCode])
  @@index([status])
  @@index([importBatchId])
  @@index([branchCode, voucherType, externalRef])
  @@index([deletedAt])
}

model DebtRecord {
  id                    String    @id @default(uuid())
  importBatchId         String?
  code                  String    @unique
  debtType              String
  partnerGroup          String    @default("EXTERNAL")
  partnerCode           String
  partnerName           String
  branchCode            String
  documentDate          DateTime
  dueDate               DateTime?
  categoryCode          String?
  /// Hạng mục P&L của khoản chi phí đã phát sinh nhưng chưa thanh toán (khai khi tạo tay).
  pnlItemCode           String?
  originalAmount        Float
  outstandingAmount     Float
  allocationMonths      Int?
  allocationStartPeriod String?
  description           String
  sourceType            String    @default("IMPORT")
  sourceId              String?
  status                String    @default("OPEN")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  importBatch ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  settlements DebtSettlement[]

  deletedAt DateTime?
  deletedBy String?

  @@index([branchCode])
  @@index([partnerCode])
  @@index([debtType, status])
  @@index([importBatchId])
  @@index([deletedAt])
}

model DebtSettlement {
  id             String   @id @default(uuid())
  debtId         String
  /// Không còn unique: một phiếu chi đại diện có thể gạch nhiều khoản công nợ cùng lúc.
  voucherId      String
  settlementDate DateTime
  amount         Float
  createdBy      String?
  createdAt      DateTime @default(now())

  debt    DebtRecord       @relation(fields: [debtId], references: [id], onDelete: Cascade)
  voucher FinancialVoucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([debtId])
  @@index([settlementDate])
}

/// Dòng phân bổ của phiếu thu/chi đại diện: một phiếu, một người nhận, nhiều đối tác.
model VoucherAllocation {
  id            String   @id @default(uuid())
  voucherId     String
  partnerCode   String
  partnerName   String
  amount        Float
  debtReference String?
  note          String?
  createdAt     DateTime @default(now())

  voucher FinancialVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([partnerCode])
}

model AssetRecord {
  id                      String              @id @default(uuid())
  code                    String              @unique
  name                    String
  branchCode              String
  departmentCode          String?
  assetGroup              String
  imageUrl                String?
  location                String?
  warehouseCode           String?
  quantity                Float               @default(1)
  purchaseDate            DateTime
  originalCost            Float
  currentValue            Float
  accumulatedDepreciation Float               @default(0)
  usefulLifeMonths        Int?
  depreciationStartDate   DateTime?
  residualValue           Float               @default(0)
  supplierCode            String?
  supplierName            String?
  paymentStatus           String              @default("UNSPECIFIED")
  payableAmount           Float               @default(0)
  paymentDueDate          DateTime?
  sourcePurchaseOrderId   String?
  sourceReceiptId         String?
  disposalDate            DateTime?
  disposalStatus          String?
  disposalAmount          Float?              @default(0)
  disposalNote            String?
  status                  String              @default("IN_USE")
  note                    String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  depreciations           AssetDepreciation[]
  stocktakeLines          AssetStocktakeLine[]
  maintenances            AssetMaintenance[]
  damageReports           AssetDamageReport[]

  deletedAt DateTime?
  deletedBy String?

  @@index([branchCode])
  @@index([warehouseCode])
  @@index([departmentCode])
  @@index([assetGroup])
  @@index([status])
  @@index([sourcePurchaseOrderId])
  @@index([deletedAt])
}

model ReconciliationMatch {
  id                String    @id @default(uuid())
  bankTransactionId String
  targetType        String
  targetId          String
  targetCode        String
  targetDate        DateTime?
  targetAmount      Float
  matchedAmount     Float
  status            String    @default("MATCHED")
  note              String?
  matchedBy         String?
  createdAt         DateTime  @default(now())

  bankTransaction BankStatementTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  deletedBy String?

  @@unique([bankTransactionId, targetType, targetId])
  @@index([targetType])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model InventoryItem {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  itemType      String
  unit          String
  category      String?
  requiresImage Boolean  @default(false)
  minStock      Float    @default(0)
  status        String   @default("ACTIVE")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  balances         InventoryBalance[]
  unitConversions  ItemUnitConversion[]
  transactionLines InventoryTransactionLine[]
  recipeLines      RecipeLine[]
  stocktakeLines   StocktakeLine[]
  requestLines     PurchaseRequestLine[]
  orderLines       PurchaseOrderLine[]
  quoteLines       SupplierQuoteLine[]
  templateLines    PurchaseRequestTemplateLine[]

  deletedAt DateTime?
  deletedBy String?

  @@index([itemType])
  @@index([status])
  @@index([deletedAt])
}

model ItemUnitConversion {
  id                String   @id @default(uuid())
  itemId            String
  unitCode          String
  unitName          String?
  conversionRate    Float
  isDefaultPurchase Boolean  @default(false)
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  deletedBy String?

  @@unique([itemId, unitCode])
  @@index([unitCode])
  @@index([isDefaultPurchase])
  @@index([deletedAt])
}

model StocktakeSession {
  id            String    @id @default(uuid())
  code          String    @unique
  stocktakeDate DateTime  @default(now())
  branchCode    String
  warehouseCode String
  status        String    @default("DRAFT")
  approvedBy    String?
  approvedAt    DateTime?
  note          String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines StocktakeLine[]

  deletedAt DateTime?
  deletedBy String?

  @@index([branchCode])
  @@index([warehouseCode])
  @@index([status])
  @@index([stocktakeDate])
  @@index([deletedAt])
}

model StocktakeLine {
  id               String  @id @default(uuid())
  stocktakeId      String
  itemId           String
  systemQuantity   Float
  actualQuantity   Float
  varianceQuantity Float
  reason           String?

  stocktake StocktakeSession @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  item      InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([stocktakeId])
  @@index([itemId])
}

model InventoryBalance {
  id            String   @id @default(uuid())
  itemId        String
  warehouseCode String
  quantity      Float    @default(0)
  averageCost   Float    @default(0)
  updatedAt     DateTime @updatedAt

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseCode])
  @@index([warehouseCode])
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  importBatchId   String?
  code            String   @unique
  transactionType String
  /// Phân loại chi tiết trong cùng một loại giao dịch. Hiện dùng cho xuất hủy:
  /// HET_HAN_SU_DUNG | KHONG_DAM_BAO_CHAT_LUONG.
  subType         String?
  transactionDate DateTime @default(now())
  branchCode      String
  warehouseCode   String
  toWarehouseCode String?
  /// Cửa hàng sở hữu kho nhận khi điều chuyển. Trống = cùng `branchCode`.
  /// Khác nhau = điều chuyển liên nhà hàng: phát sinh công nợ nội bộ phải thu & phải trả.
  toBranchCode    String?
  /// Công nợ nội bộ sinh khi điều chuyển hàng liên nhà hàng, cùng cơ chế với Điều tiền.
  internalReceivableDebtCode String?
  internalPayableDebtCode    String?
  referenceType   String?
  referenceId     String?
  referenceCode   String?
  status          String   @default("POSTED")
  partnerCode     String?
  note            String?
  createdBy       String?
  createdAt       DateTime @default(now())

  importBatch ImportBatch?               @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  lines       InventoryTransactionLine[]

  deletedAt DateTime?
  deletedBy String?

  @@index([transactionType])
  @@index([subType])
  @@index([transactionDate])
  @@index([warehouseCode])
  @@index([toWarehouseCode])
  @@index([toBranchCode])
  @@index([importBatchId])
  @@index([deletedAt])
}

model InventoryTransactionLine {
  id             String  @id @default(uuid())
  transactionId  String
  itemId         String
  quantity       Float
  unitCost       Float
  totalCost      Float
  inputQuantity  Float?
  inputUnitCode  String?
  conversionRate Float   @default(1)
  inputUnitCost  Float?

  transaction InventoryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  item        InventoryItem        @relation(fields: [itemId], references: [id])

  @@index([transactionId])
  @@index([itemId])
}

/// Mẫu yêu cầu mua hàng do quản lý set sẵn (tên hàng + ĐVT). Bộ phận cần đặt chỉ mở mẫu,
/// điền số lượng vào các dòng cần mua rồi gửi — hệ thống tạo PR nhiều dòng từ mẫu.
model PurchaseRequestTemplate {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  /// Trống = mẫu dùng chung cho mọi cửa hàng.
  branchCode     String?
  /// Bộ phận mặc định điền sẵn khi đặt theo mẫu (bếp, bar...); người đặt vẫn đổi được.
  departmentCode String?
  status         String   @default("ACTIVE")
  note           String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines PurchaseRequestTemplateLine[]

  deletedAt DateTime?
  deletedBy String?

  @@index([status])
  @@index([branchCode])
  @@index([deletedAt])
}

model PurchaseRequestTemplateLine {
  id         String  @id @default(uuid())
  templateId String
  itemId     String
  /// ĐVT đặt hàng trên mẫu (mã trong ItemUnitConversion). Trống = ĐVT mua mặc định của mặt hàng.
  unitCode   String?
  sortOrder  Int     @default(0)
  note       String?

  template PurchaseRequestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item     InventoryItem           @relation(fields: [itemId], references: [id])

  @@index([templateId])
  @@index([itemId])
}

