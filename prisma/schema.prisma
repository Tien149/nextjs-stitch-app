model MoneyTransfer {
  id                  String    @id @default(uuid())
  importBatchId       String?
  code                String    @unique
  transferDate        DateTime
  /// Ngày tiền mặt thực tế rời quỹ và vào nguồn nhận. Chỉ bắt buộc khi duyệt CASH_DEPOSIT mới.
  actualTransferDate  DateTime?
  branchCode          String
  /// Cửa hàng sở hữu nguồn tiền đi / nguồn tiền nhận. Trống nghĩa là cùng `branchCode`.
  /// Khác nhau = điều tiền liên nhà hàng: mỗi đầu ghi sổ riêng và sinh công nợ nội bộ.
  fromBranchCode      String?
  toBranchCode        String?
  /// Công nợ nội bộ sinh khi duyệt phiếu liên nhà hàng: bên chuyển có phải thu, bên nhận
  /// có phải trả. Hoàn tiền thì phiếu thu/chi gạch thẳng vào hai mã này.
  internalReceivableDebtCode String?
  internalPayableDebtCode    String?
  fromMoneySourceCode String
  toMoneySourceCode   String
  amount              Float
  externalRef         String?
  description         String
  transferPurpose     String?
  /// Chênh lệch giữa nguồn cần clear và số thực nhận/nộp: gross = amount + feeAmount.
  /// Phí ví và làm tròn xuống là số dương; làm tròn tiền nộp lên là chi phí âm.
  feeAmount           Float     @default(0)
  feeCategoryCode     String?
  /// Phần chi phí bán hàng Grab nằm trong feeAmount; phần còn lại là phí cà thẻ.
  grabExpenseAmount       Float  @default(0)
  grabExpenseCategoryCode String?
  depositTargetType   String?
  sourceReportDate    DateTime?
  sourceShift         String?
  status              String    @default("PENDING_REVIEW")
  createdBy           String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  importBatch   ImportBatch?                @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  denominations MoneyTransferDenomination[]

  deletedAt DateTime?
  deletedBy String?

  @@index([transferDate])
  @@index([actualTransferDate])
  @@index([branchCode])
  @@index([fromBranchCode])
  @@index([toBranchCode])
  @@index([status])
  @@index([transferPurpose])
  @@index([sourceReportDate])
  @@index([importBatchId])
  @@index([branchCode, externalRef])
  @@index([deletedAt])
}

