/// Tỷ trọng chi phí chuẩn của từng bộ phận so với doanh thu (feedback chị Bình 26/08/2026):
/// ví dụ lương Bếp 12.8%, Bar 2%, FOH 7%... "Lương theo tiêu chuẩn" của kỳ = doanh thu kỳ đó
/// nhân tỷ trọng, đem so với lương thực chi trả từ import bảng lương.
model DepartmentCostRatio {
  id             String   @id @default(uuid())
  /// Áp theo năm (ví dụ "2026") — set một lần dùng cho cả 12 tháng của năm đó.
  year           String
  branchCode     String
  departmentCode String
  metric         String   @default("payroll")
  /// Khoảng tỷ trọng tham chiếu của ngành F&B (0.10 - 0.12 = 10-12%), chỉ để hiển thị.
  industryMin    Float?
  industryMax    Float?
  /// Tỷ trọng áp dụng thực tế, 0.128 = 12.8% doanh thu.
  ratio          Float
  note           String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deletedAt DateTime?
  deletedBy String?

  @@unique([year, branchCode, departmentCode, metric])
  @@index([year])
  @@index([deletedAt])
}

model Role {
  id         String   @id @default(uuid())
  name       String   @unique
  actions    String[]
  menuAccess String[]
  users      User[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  password       String
  name           String
  phone          String?
  position       String?
  roleId         String
  role           Role               @relation(fields: [roleId], references: [id])
  branchAccesses UserBranchAccess[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  deletedAt DateTime?
  deletedBy String?

  @@index([roleId])
  @@index([deletedAt])
}

model UserBranchAccess {
  id         String @id @default(uuid())
  userId     String
  branchCode String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchCode])
  @@index([userId])
}

/// Kiểm kê CCDC & Tài sản — tách khỏi kiểm kê hàng tồn kho theo yêu cầu khách:
/// hàng hoá kiểm ở Kho & Định lượng, CCDC/tài sản kiểm ở Tài sản & khấu hao.
model AssetStocktakeSession {
  id            String    @id @default(uuid())
  importBatchId String?
  code          String    @unique
  stocktakeDate DateTime
  branchCode    String
  status        String    @default("APPROVED")
  note          String?
  createdBy     String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  importBatch ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  lines       AssetStocktakeLine[]

  deletedAt DateTime?
  deletedBy String?

  @@index([branchCode])
  @@index([stocktakeDate])
  @@index([deletedAt])
}

model AssetStocktakeLine {
  id               String  @id @default(uuid())
  sessionId        String
  assetId          String
  systemQuantity   Float
  actualQuantity   Float
  varianceQuantity Float
  condition        String?
  note             String?

  session AssetStocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  asset   AssetRecord           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([assetId])
}
