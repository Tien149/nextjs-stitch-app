model Recipe {
  id            String   @id @default(uuid())
  code          String   @unique
  productCode   String
  productName   String
  /// ĐVT của mẻ chuẩn bị (nhất là bán thành phẩm: 1kg, 400gr, 1 lít sốt...).
  /// Để trống = trùng ĐVT tồn kho của sản phẩm.
  unit          String
  /// Hệ số quy đổi mẻ chuẩn bị về ĐVT tồn kho: 1 `unit` = bao nhiêu ĐVT tồn kho.
  /// Định lượng nguyên liệu khai cho MỘT mẻ `unit`, chia hệ số này ra cost/ĐVT tồn kho.
  outputConversionRate Float @default(1)
  sellingPrice  Float    @default(0)
  version       Int      @default(1)
  effectiveFrom DateTime @default(now())
  status        String   @default("ACTIVE")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines RecipeLine[]

  deletedAt DateTime?
  deletedBy String?

  @@index([productCode])
  @@index([status])
  @@index([effectiveFrom])
  @@index([deletedAt])
}

